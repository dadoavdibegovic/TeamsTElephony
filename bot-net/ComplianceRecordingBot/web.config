<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        hostingModel="outofprocess": Microsoft.Skype.Bots.Media loads NativeMedia.dll which
        uses native Win32 threading that conflicts with IIS in-process hosting (causes
        0xe0434352 / CLR worker thread exited prematurely). Out-of-process runs the .NET app
        as a separate process reverse-proxied by IIS, which avoids the native DLL conflict.
        stdoutLogEnabled="true" captures startup output for diagnostics.
      -->
      <aspNetCore processPath=".\ComplianceRecordingBot.exe"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="outofprocess" />
    </system.webServer>
  </location>
</configuration>
