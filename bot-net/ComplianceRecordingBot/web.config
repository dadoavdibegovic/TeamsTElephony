<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        hostingModel="outofprocess" is REQUIRED: Microsoft.Skype.Bots.Media loads
        NativeMedia.dll, whose native Win32 threading is incompatible with in-process
        hosting inside w3wp.exe (inprocess crashes at startup with 0xe0434352 /
        "CLR worker thread exited prematurely" / "failed to load coreclr"). Out-of-process
        runs the .NET app as its own process reverse-proxied by IIS, which the native
        DLL tolerates. Verified: the published exe starts cleanly as a standalone process.

        The earlier outofprocess "Failed to bind to 127.0.0.1:<port>: address already in
        use" (0x8027025b) was NOT a hosting-model problem — it was Program.cs manually
        calling ListenAnyIP(ASPNETCORE_PORT) on top of the binding UseIISIntegration
        already sets up, i.e. a double-bind. Program.cs no longer binds Kestrel manually;
        UseIISIntegration owns the ANCM-assigned port.
        stdoutLogEnabled="true" captures startup output for diagnostics.
      -->
      <aspNetCore processPath=".\ComplianceRecordingBot.exe"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="outofprocess" />
    </system.webServer>
  </location>
</configuration>
