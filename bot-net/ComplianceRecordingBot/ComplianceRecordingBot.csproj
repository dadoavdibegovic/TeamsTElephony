<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ComplianceRecordingBot</RootNamespace>
    <AssemblyName>ComplianceRecordingBot</AssemblyName>
    <!--
      Microsoft.Skype.Bots.Media ships NativeMedia.dll (win-x64) and NativeMedia.so
      (linux-x64), but only the Windows variant works in Azure App Service because the
      SDK uses COM/Win32 internals at runtime. RuntimeIdentifier is NOT set here so that
      local Windows dev builds work without explicit flags. For Azure App Service (Windows
      P2v3) publish, pass: -r win-x64 -p:SelfContained=false on the command line.
      NOTE: Do not target linux-x64 as MediaPlatform.Initialize will throw DllNotFoundException.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!--
      Graph Communications SDK — 1.2.0.10563 is the latest stable set that does NOT
      require a preview build of Microsoft.Skype.Bots.Media. Newer versions (1.2.0.15235+)
      depend on Microsoft.Skype.Bots.Media 1.31.0.225-preview which has no stable
      successor yet. Pin to 10563 + 1.30.0.49 (the only fully-stable combination).
    -->
    <PackageReference Include="Microsoft.Graph.Communications.Calls"       Version="1.2.0.10563" />
    <PackageReference Include="Microsoft.Graph.Communications.Calls.Media" Version="1.2.0.10563" />
    <PackageReference Include="Microsoft.Graph.Communications.Client"      Version="1.2.0.10563" />
    <PackageReference Include="Microsoft.Graph.Communications.Common"      Version="1.2.0.10563" />

    <!-- Latest fully-stable Skype.Bots.Media (1.30.0.49 satisfies the >= 1.26.0.94-alpha dep above) -->
    <PackageReference Include="Microsoft.Skype.Bots.Media" Version="1.30.0.49" />

    <!-- JWT validation for inbound Graph Communications notifications -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.18.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt"                 Version="8.18.0" />

    <!-- Azure / secrets -->
    <PackageReference Include="Azure.Identity"                              Version="1.13.2" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets"             Version="4.7.0" />
    <!-- Pulls KV secrets into IConfiguration via the VM's managed identity (no secrets on disk). -->
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.2" />
    <!-- Lets the bot run under the Windows Service Control Manager on the VM. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.1" />

    <!-- Telemetry -->
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore"    Version="2.22.0" />
  </ItemGroup>

</Project>
